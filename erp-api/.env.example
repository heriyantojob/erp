# ============================================================
# FKA ERP API - example environment only
# Copy to .env and replace placeholders for local development.
# Do not commit real secrets.
# ============================================================
NODE_ENV=development
PORT=4000

# PostgreSQL
DB_URL=postgresql://postgres:postgres@localhost:5432/fka_inventory

# Browser / frontend origin
CORS_ORIGIN=http://localhost:3100

# Better Auth
BETTER_AUTH_SECRET=replace-with-a-long-random-local-secret
BETTER_AUTH_URL=http://localhost:4000
BETTER_AUTH_DOMAIN=localhost

# Optional Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# S3-compatible object storage (optional for the ERP assessment core)
AWS_ENDPOINT=http://localhost:9000
AWS_ENDPOINT_HOST=localhost:9000
AWS_REGION=auto
AWS_ACCESS=your-access-key
AWS_SECRET=your-secret-key
AWS_BUCKET_NAME=fka-erp
NEXT_PUBLIC_AWS_URL_FILE=http://localhost:9000/fka-erp

# Email (optional)
RESEND_API_KEY=your-resend-api-key
EMAIL_SENDER_NAME=FKA ERP
EMAIL_SENDER_ADDRESS=noreply@example.test

# Admin path used by retained application modules
ADMIN_ROUTE=admin
