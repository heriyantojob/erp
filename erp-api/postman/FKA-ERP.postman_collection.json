                "value": "{{locale}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/sign-in/email",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "sign-in", "email"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"warehouse@erp.test\",\n  \"password\": \"asdf1234\"\n}"
            }
          }
        },
        {
          "name": "Login - Production",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Locale",
