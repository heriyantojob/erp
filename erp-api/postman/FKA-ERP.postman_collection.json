{
  "info": {
    "name": "FKA ERP API",
    "description": "Postman collection for Better Auth login and FKA ERP user management. Run Login first. Postman keeps the session cookie automatically; the test also stores a bearer token when Better Auth returns one.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "authToken",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "locale",
      "value": "en"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Locale",
                "value": "{{locale}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login - System Administrator",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Locale",
                "value": "{{locale}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/sign-in/email",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "sign-in", "email"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@erp.test\",\n  \"password\": \"1234asdf\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login successful', function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
                  "const headerToken = pm.response.headers.get('set-auth-token');",
                  "let json = {}; try { json = pm.response.json(); } catch (e) {}",
                  "const token = headerToken || json.token || json.accessToken || (json.session && json.session.token);",
                  "if (token) pm.collectionVariables.set('authToken', token);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Current Session",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text",
                "disabled": true
              },
              {
                "key": "X-Locale",
                "value": "{{locale}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/me",
              "host": ["{{baseUrl}}"],
              "path": ["me"]
            }
          }
        },
        {
          "name": "Sign Out",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text",
                "disabled": true
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Locale",
                "value": "{{locale}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/sign-out",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "sign-out"]
            },
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          }
        }
      ]
    },
    {
      "name": "User Management",
      "item": [
        {
          "name": "Get Access and Permissions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text",
                "disabled": true
              },
              {
                "key": "X-Locale",
                "value": "{{locale}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/erp/security/access",
              "host": ["{{baseUrl}}"],
              "path": ["erp", "security", "access"]
            }
          }
        },
        {
          "name": "List Roles",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text",
                "disabled": true
              },
              {
                "key": "X-Locale",
                "value": "{{locale}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/erp/security/roles",
              "host": ["{{baseUrl}}"],
              "path": ["erp", "security", "roles"]
            }
          }
        },
        {
          "name": "List Users",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text",
                "disabled": true
              },
              {
                "key": "X-Locale",
                "value": "{{locale}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/erp/security/users",
              "host": ["{{baseUrl}}"],
              "path": ["erp", "security", "users"]
            }
          }
        },
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text",
                "disabled": true
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Locale",
                "value": "{{locale}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/erp/security/users",
              "host": ["{{baseUrl}}"],
              "path": ["erp", "security", "users"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Demo New User\",\n  \"email\": \"new.user@fka-erp.local\",\n  \"password\": \"NewUser!ERP2026\",\n  \"roleCodes\": [\n    \"warehouse_user\"\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('User created', function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
                  "const json = pm.response.json(); if (json.id) pm.collectionVariables.set('userId', json.id);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Update User",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text",
                "disabled": true
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Locale",
                "value": "{{locale}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/erp/security/users/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["erp", "security", "users", "{{userId}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Demo Updated User\",\n  \"email\": \"new.user@fka-erp.local\",\n  \"banned\": false,\n  \"roleCodes\": [\n    \"warehouse_user\",\n    \"production_user\"\n  ]\n}"
            }
          }
        },
        {
          "name": "Soft Delete User",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "type": "text",
                "disabled": true
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Locale",
                "value": "{{locale}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/erp/security/users/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["erp", "security", "users", "{{userId}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Removed from Postman demo\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Demo User Logins",
      "item": [
        {
          "name": "Login - Warehouse",
          "request": {
            "method": "POST",
            "header": [
              {
