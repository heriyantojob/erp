# ============================================================
# FKA ERP Frontend - example environment only
# Copy to .env.local and replace placeholders as required.
# Do not commit real secrets.
# ============================================================
NEXT_PUBLIC_ENV_LOG=development
NEXT_PUBLIC_BASE_URL=http://localhost:3100
NEXT_PUBLIC_URL_HOST=http://localhost:3100
NEXT_PUBLIC_API_URL_EXPRESS=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_ADMIN_ROUTE=admin

# Optional retained application URLs
NEXT_PUBLIC_URL_DESIGN=http://localhost:3100
NEXT_PUBLIC_URL_BLOG=http://localhost:3100
DB_PREFIX=fka_erp

# Optional object storage configuration
AWS_ENDPOINT_HOST=localhost:9000
AWS_ENDPOINT=http://localhost:9000
AWS_BUCKET_NAME=fka-erp
NEXT_PUBLIC_AWS_URL_FILE=http://localhost:9000/fka-erp
AWS_URL_FILE=http://localhost:9000/fka-erp

# Better Auth client/server values where used by retained modules
BETTER_AUTH_SECRET=replace-with-the-same-local-secret-as-api
BETTER_AUTH_URL=http://localhost:4000

# Optional external APIs retained from the wider codebase
NEXT_PUBLIC_PIXABAY_API_KEY=your-pixabay-api-key
FREESOUND_API_KEY=your-freesound-api-key
FREESOUND_CLIENT_ID=your-freesound-client-id
NEXT_PUBLIC_CONTACT_HP1=+620000000000
NEXT_PUBLIC_EMAIL=contact@example.test
